# Used by docker-compose.yaml to configure the db and api services.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=houses

# Used when running the API directly with `uv run`, outside Docker Compose.
# Leave it unset to use a local SQLite file (houses.db) instead of Postgres.
DB_CONN=postgresql+psycopg://postgres:postgres@localhost:5432/houses
